<div class="lato-cms-media-field__tile lato-cms-media-field__item"
     data-media-id="<%= media.id %>"
     data-lato-cms-media-field-target="item"
     <% if multiple %>
       data-lato-cms-media-reorder-target="item"
       draggable="true"
       data-action="dragstart->lato-cms-media-reorder#onDragStart dragend->lato-cms-media-reorder#onDragEnd"
     <% end %>>
  <% if kind == 'video' %>
    <video muted preload="metadata" class="lato-cms-media-field__player" src="<%= media.url %>"></video>
    <i class="bi bi-play-circle-fill lato-cms-media-field__badge"></i>
  <% elsif media.thumbnail_url %>
    <img src="<%= media.thumbnail_url %>" class="lato-cms-media-field__thumb" alt="<%= media.alt_text %>">
  <% else %>
    <div class="lato-cms-media-field__icon"><i class="bi bi-paperclip"></i></div>
  <% end %>

  <div class="lato-cms-media-field__overlay">
    <span class="lato-cms-media-field__name"><%= media.name %></span>
  </div>

  <button type="button" class="lato-cms-media-field__remove" title="<%= t('lato_cms.field_file_remove') %>" aria-label="<%= t('lato_cms.field_file_remove') %>" data-action="lato-cms-media-field#remove">
    <i class="bi bi-x-lg"></i>
  </button>

  <input type="hidden" name="<%= hidden_name %>" value="<%= media.id %>" data-lato-cms-media-field-target="hiddenInput">
</div>

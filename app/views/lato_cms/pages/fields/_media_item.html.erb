<% wide = !multiple && %w[image video].include?(kind) %>
<div class="lato-cms-media-field__tile lato-cms-media-field__item<%= ' lato-cms-media-field__tile--wide' if wide %>"
     data-media-id="<%= media.id %>"
     data-lato-cms-media-field-target="item"
     <% if multiple %>
       data-lato-cms-media-reorder-target="item"
       draggable="true"
       data-action="dragstart->lato-cms-media-reorder#onDragStart dragend->lato-cms-media-reorder#onDragEnd"
     <% end %>>
  <% if kind == 'video' %>
    <%# With a poster the browser fetches nothing but that image until the admin
        hits play: a page can hold many video fields, and preloading metadata
        for each one meant every video file was requested just to open the
        editor (enough of them and the players stall before they ever start).
        Without a poster there's nothing else to show, so metadata it is. %>
    <video controls preload="<%= media.poster_url ? 'none' : 'metadata' %>" poster="<%= media.poster_url %>"
      class="lato-cms-media-field__player" src="<%= media.url %>"></video>
  <% elsif media.thumbnail_url %>
    <img src="<%= media.thumbnail_url %>" class="lato-cms-media-field__thumb" alt="<%= media.alt_text.presence || media.name %>">
  <% else %>
    <div class="lato-cms-media-field__icon"><i class="bi bi-paperclip"></i></div>
  <% end %>

  <div class="lato-cms-media-field__overlay">
    <span class="lato-cms-media-field__name"><%= media.name %></span>
  </div>

  <button type="button" class="lato-cms-media-field__remove" title="<%= t('lato_cms.field_file_remove') %>" aria-label="<%= t('lato_cms.field_file_remove') %> <%= media.name %>" data-action="lato-cms-media-field#remove">
    <i class="bi bi-x-lg" aria-hidden="true"></i>
  </button>
  <% if multiple %>
    <%# Keyboard alternative to drag & drop reordering. %>
    <button type="button" class="lato-cms-media-field__move lato-cms-media-field__move--before" title="<%= t('lato_cms.media_move_before') %>"
      aria-label="<%= t('lato_cms.media_move_before') %> <%= media.name %>" data-action="lato-cms-media-reorder#moveBefore">
      <i class="bi bi-arrow-left" aria-hidden="true"></i>
    </button>
    <button type="button" class="lato-cms-media-field__move lato-cms-media-field__move--after" title="<%= t('lato_cms.media_move_after') %>"
      aria-label="<%= t('lato_cms.media_move_after') %> <%= media.name %>" data-action="lato-cms-media-reorder#moveAfter">
      <i class="bi bi-arrow-right" aria-hidden="true"></i>
    </button>
  <% end %>

  <input type="hidden" name="<%= hidden_name %>" value="<%= media.id %>" data-lato-cms-media-field-target="hiddenInput">
</div>
